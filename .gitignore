# Segredos e ambiente
.env
.env.*
!.env.example

# Dependências
node_modules/

# Banco de produção (grupos, warns, eventos — dados privados)
db/grouphelp.db
db/grouphelp.db-shm
db/grouphelp.db-wal
db/*.db-shm
db/*.db-wal

# Modelos pesados (regenere com: node bin/treinar.js — requer binário fasttext)
db/fasttext/spam.ftz
db/fasttext/spam.vec
db/fasttext/spam.bin
*.ftz
*.vec
*.bin

# Logs de runtime
log/*.log
*.log

# Backups locais (código + banco)
backups/
!backups/.gitkeep

# Área de trabalho do corpus (scripts .py versionados; dados/cache ignorados)
Dado novos/*.json
Dado novos/backup/
Dado novos/cache_trans_*.json
Dado novos/__pycache__/
Dado novos/*.log
__pycache__/

# Grafo de código local (regenere com: graphify update .)
graphify-out/

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo
